	column has_food_item
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: ae575443-18d4-4a27-960f-ee1c19c6d5d8
		summarizeBy: none
		sourceColumn: has_food_item

		annotation SummarizationSetBy = Automatic


	measure 'Avg Fulfillment Time' = AVERAGE(FactOrders[fulfillment_time_min])
		formatString: 0.00
		lineageTag: a1b2c3d4-e5f6-4a5b-8c9d-0e1f2a3b4c5d

	measure 'Morning Rush Avg' = CALCULATE([Avg Fulfillment Time], DimTime[time_period] = "Morning Rush")
		formatString: 0.00

	measure 'Complexity vs Delay Correlation' = VAR MeanX = AVERAGE(FactOrders[num_customizations]) VAR MeanY = AVERAGE(FactOrders[fulfillment_time_min]) RETURN DIVIDE(SUMX(FactOrders, (FactOrders[num_customizations] - MeanX) * (FactOrders[fulfillment_time_min] - MeanY)), SQRT(SUMX(FactOrders, (FactOrders[num_customizations] - MeanX) ^ 2) * SUMX(FactOrders, (FactOrders[fulfillment_time_min] - MeanY) ^ 2)))
		formatString: 0.00
		lineageTag: c3d4e5f6-7a8b-9c0d-1e2f-3a4b5c6d7e8f

	measure 'Avg Satisfaction' = AVERAGE(FactOrders[customer_satisfaction])
		formatString: 0.00
		lineageTag: d4e5f6a7-8b9c-0d1e-2f3a-4b5c6d7e8f9a

	measure 'Total Orders' = COUNTROWS(FactOrders)
		formatString: 0
		lineageTag: e5f6a7b8-9c0d-1e2f-3a4b-5c6d7e8f9a0b
	partition FactOrders = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database("localhost", "starbucks_dw_raw"),
				    Source = Origen{[Schema="star",Item="fact_orders"]}[Data]
				in
				    Source

	annotation PBI_NavigationStepName = Navegación

